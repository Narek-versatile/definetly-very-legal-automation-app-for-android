<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Keep the screen on/awake during a sweep so the accessibility service can
         keep tapping (the vote pages don't render with the screen off). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- The 3-hourly reminder / automatic sweep uses exact alarms that fire in
         Doze, and re-arm after a reboot. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Overnight/auto setup: exempt from battery optimisation so scheduled
         sweeps aren't deferred, and allow drawing over other apps to help the
         waker launch from the background on Samsung. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
      Needed to list installed apps and launch them by package name (the
      "Launch app" step). This is a sensitive permission; the app only reads
      the launcher list and never transmits it off the device.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LegalAutomation"
        tools:targetApi="31">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.LegalAutomation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Translucent tap-location recorder used by the step editor and the
             vote-sweep app-cycle setup. -->
        <activity
            android:name=".ui.TapRecorderActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Transparent" />

        <!-- Invisible waker for automatic (scheduled) sweeps: turns the screen
             on and dismisses a non-secure keyguard before the sweep starts. -->
        <activity
            android:name=".ui.WakeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.Transparent" />

        <!-- The cross-app automation engine (find-by-text, tap, scroll, verify). -->
        <service
            android:name=".service.AutomationAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Foreground runner so long automations survive screen-off. -->
        <service
            android:name=".engine.RunnerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs user-defined UI automations across apps." />
        </service>

        <!-- Foreground runner for the multi-nickname vote sweep. -->
        <service
            android:name=".engine.SweepRunnerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs the multi-nickname vote sweep across apps." />
        </service>

        <!-- Draggable floating pause/resume bubble shown while a run is active. -->
        <service
            android:name=".engine.FloatingControlService"
            android:exported="false" />

        <!-- Fires the 3-hourly reminder / automatic sweep alarms, and the
             "Start sweep now" button on the reminder notification. -->
        <receiver
            android:name=".engine.SweepAlarmReceiver"
            android:exported="false" />

        <!-- Re-arms the sweep alarms after a reboot. -->
        <receiver
            android:name=".engine.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Shizuku wiring for low-level operations (launch app, type text). -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"
            tools:ignore="ExportedContentProvider" />
    </application>
</manifest>
